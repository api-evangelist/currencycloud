          "id": "8909539b-098c-44e9-9c8b-27bab0589bfa",
          "name": "Logout",
          "request": {
            "name": "Logout",
            "description": {
              "content": "Authentication tokens expire automatically after 30 minutes of inactivity. If a session is no longer required, it is good security practice to retire its authentication token early rather than leave it to time out.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "authenticate",
                "close_session"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) Authentication token",
                "key": "X-Auth-Token",
                "value": ""
