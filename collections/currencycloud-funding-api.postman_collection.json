      "description": {
        "content": "Find funding accounts that can be used to settle and collect funds in each available currency.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "8e094078-d5a8-4377-915a-71ccdde35e6b",
          "name": "Find Funding Accounts",
          "request": {
            "name": "Find Funding Accounts",
            "description": {
              "content": "Gets details of the Standard Settlement Instructions (SSIs) that can be used to settle and collect funds in each available currency.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "funding_accounts",
                "find"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "description": {
                    "content": "The type of SSI to be returned, priority (Swift) or regular (local). A null value returns all payment types. (This can only be one of priority,regular)",
                    "type": "text/plain"
                  },
                  "key": "payment_type",
                  "value": ""
                },
                {
                  "description": {
                    "content": "(Required) The currency of the account details required, ISO 4217 standard.",
                    "type": "text/plain"
                  },
                  "key": "currency",
                  "value": ""
                },
                {
                  "description": {
                    "content": "UUID of a specific sub-account you want to see the SSIs for.",
                    "type": "text/plain"
                  },
                  "key": "account_id",
                  "value": ""
                },
                {
                  "description": {
                    "content": "A contact UUID for the sub-account you're acting on behalf of.",
                    "type": "text/plain"
                  },
                  "key": "on_behalf_of",
                  "value": ""
                },
                {
                  "description": {
                    "content": "Page number",
                    "type": "text/plain"
                  },
                  "key": "page",
                  "value": ""
                },
                {
                  "description": {
                    "content": "Number of results per page.",
                    "type": "text/plain"
                  },
                  "key": "per_page",
                  "value": ""
                },
                {
                  "description": {
                    "content": "Any field name to change the sort order.",
                    "type": "text/plain"
                  },
                  "key": "order",
                  "value": ""
                },
                {
                  "description": {
                    "content": "Sort records in ascending or descending order. (This can only be one of asc,desc)",
                    "type": "text/plain"
                  },
                  "key": "order_asc_desc",
                  "value": ""
                }
              ],
