{
  "opencollection": "1.0.0",
  "info": {
    "name": "api-onboarding Account Usage Currency API",
    "version": "v1"
  },
  "items": [
    {
      "info": {
        "name": "Currency",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Supported Currencies",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/onboarding/v1/currencies/supported",
            "auth": {
              "type": "apikey",
              "key": "X-Auth-Token",
              "value": "{{X-Auth-Token}}",
              "placement": "header"
            }
          },
          "docs": "Returns a list of supported currencies."
        }
      ]
    }
  ],
  "bundled": true
}