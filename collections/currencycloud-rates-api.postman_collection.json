        {
          "id": "8d92e0df-8979-4324-962f-c19f8432d0ee",
          "name": "Get Detailed Rates",
          "request": {
            "name": "Get Detailed Rates",
            "description": {
              "content": "Gets a detailed, tradeable rate quote to convert money from one currency to another. The quotation provided will be based on the spread table of the authenticated user. There is also the option to provide a specific date for the conversion to occur. <br><br> This endpoint provides a current tradeable rate for a single currency pair. It should be used as the start of the flow before a conversion is booked. This endpoint should be used where accuracy is the most important aspect, such as when a trade is about to be booked.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "rates",
                "detailed"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "description": {
                    "content": "(Required) Currency purchased - three-letter ISO code.",
                    "type": "text/plain"
                  },
                  "key": "buy_currency",
                  "value": ""
                },
                {
                  "description": {
                    "content": "(Required) Currency sold - three-letter ISO code.",
                    "type": "text/plain"
                  },
                  "key": "sell_currency",
                  "value": ""
                },
                {
                  "description": {
                    "content": "(Required) Fix the buy or sell currency. (This can only be one of buy,sell)",
                    "type": "text/plain"
                  },
                  "key": "fixed_side",
                  "value": ""
                },
                {
                  "description": {
                    "content": "(Required) Amount of the fixed buy or sell currency.",
                    "type": "text/plain"
                  },
                  "key": "amount",
                  "value": ""
                },
                {
                  "description": {
                    "content": "A contact UUID for the sub-account you're acting on behalf of.",
                    "type": "text/plain"
                  },
                  "key": "on_behalf_of",
                  "value": ""
                },
                {
                  "description": {
                    "content": "Date of delivery of purchased currency. ISO 8601 format YYYY-MM-DD. If not specified, deals settle in two working days.",
                    "type": "text/plain"
                  },
                  "key": "conversion_date",
                  "value": ""
                },
                {
                  "description": {
                    "content": "Available only if conversion_date is not provided. Must be one of the following:<br> 'earliest' for earliest available conversion date. Make sure there is sufficient time to send funds to Currencycloud.<br> 'next_day' for next day available conversion date - T+1.<br> 'default' for conversion - T+1 for <a href=\"https://support.currencycloud.com/hc/en-gb/articles/360017419080-Making-payments-to-India-Indonesia-Malaysia-and-the-Philippines-INR-IDR-MYR-PHP-FAQ\">APAC restricted currencies</a>, T+2 for all others.<br> 'optimize_liquidity' for maximizing chances of getting a successful rate. Most relevant for exotic pairs. Conversion is T+0 for <a href=\"https://support.currencycloud.com/hc/en-gb/articles/360017419080-Making-payments-to-India-Indonesia-Malaysia-and-the-Philippines-INR-IDR-MYR-PHP-FAQ\">APAC restricted currencies</a>, and T+1 or T+2 for all others. (This can only be one of default,earliest,next_day,optimize_liquidity)",
                    "type": "text/plain"
                  },
                  "key": "conversion_date_preference",
                  "value": ""
                }
              ],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) Authentication token",
                "key": "X-Auth-Token",
                "value": ""
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
