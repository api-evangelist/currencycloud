{
  "item": [
    {
      "id": "91bc5b8d-af8d-4839-b884-e2bd2e5e3a29",
      "name": "Rates",
      "description": {
        "content": "Super fast real-time access to live foreign exchange rates through the Currencycloud platform.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "ba669c62-65f2-43c6-9bfe-4c37089fe0f5",
          "name": "Get Basic Rates",
          "request": {
            "name": "Get Basic Rates",
            "description": {
              "content": "Gets indicative foreign exchange rate information for one or more currency pairs in a single request. <br><br> This endpoint is intended to provide an indication of the rate available in the market and can support requests for multiple currency pairs, so is good for polling requirements such as live FX ticker widgets. This endpoint should be used where speed, availability and the ability to request multiple currency pairs is important.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "rates",
                "find"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "description": {
                    "content": "(Required) Concatenated string of the two currencies traded, e.g. \"USDEUR\". More than one pair can be entered, separated by a comma e.g. \"EURGBP,GBPUSD,EURUSD\".",
                    "type": "text/plain"
                  },
                  "key": "currency_pair",
                  "value": ""
                },
                {
                  "description": {
                    "content": "A contact UUID for the sub-account you're acting on behalf of.",
                    "type": "text/plain"
                  },
                  "key": "on_behalf_of",
                  "value": ""
                },
                {
                  "description": {
                    "content": "Ignore the validation of currency pairs.",
                    "type": "text/plain"
                  },
                  "key": "ignore_invalid_pairs",
                  "value": ""
                }
              ],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) Authentication token",
                "key": "X-Auth-Token",
                "value": ""
              }
            ],
            "method": "GET",
            "auth": null
          },
